<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      A front door seen from outside the car, with the glass dropped: the sill
      line across the middle and an arrow pointing down where the glass goes,
      and the side of the car lettered on the door panel. Front and rear doors
      differ in shape - the slope at the front, or at the back with the
      quarter-light divider - and the right-hand pair are these mirrored, as
      they would be walking round the car; the letter is drawn the right way
      round on both.
    -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,21 L3,10.5 C3,9 5.5,3.5 10,3.5 L20.5,3.5 L20.5,21 Z" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:pathData="M4.6,12 L20.5,12" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M13,6 L13,9.6 M11.3,8 L13,9.7 L14.7,8" />
    <!-- L -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9.8,14 L9.8,20 L13.8,20" />
</vector>
