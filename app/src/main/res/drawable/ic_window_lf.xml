<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      A front door seen from outside the car, with the glass dropped: the sill
      line across the middle and an arrow pointing down where the glass goes.
      Which door is which is in the shape, not a marker. A front door has its
      sloped edge at the front; a rear door has it at the back and carries the
      quarter-light divider. The right-hand doors are these two mirrored, as
      they would be if you walked round the car - so the four glyphs are four
      shapes, and the slope alone says which side.
    -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,21 L3,10.5 C3,9 5.5,3.5 10,3.5 L20.5,3.5 L20.5,21 Z" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:pathData="M4.6,12 L20.5,12" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M13,6 L13,9.6 M11.3,8 L13,9.7 L14.7,8" />
</vector>
