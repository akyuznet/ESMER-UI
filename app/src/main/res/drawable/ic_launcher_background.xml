<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's ground: the app's own graphite, lifted just enough to read as a
  surface. The UI itself is pure black by design - "switched-off pixels" - but an
  icon painted that way disappears into a dark launcher, so this carries a slight
  diagonal gradient instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF0D1217" />
                <item android:offset="0.55" android:color="#FF151D25" />
                <item android:offset="1" android:color="#FF1F2A36" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
