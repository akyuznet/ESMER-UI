<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off by default at targetSdk 28+, which silently blocks the call to
  OverDrive's REST API. Permit it for the loopback interface only - the launcher
  makes no other network requests, so nothing broader should be opened up.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
