<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is off by default at targetSdk 28+, which would silently block the
  call to OverDrive's REST API on the loopback interface and, since the Home
  Assistant tab, the user's own server - most home installs answer on plain
  http at a LAN address or a .local name that cannot be known in advance.
  The launcher sends nothing else over the network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
