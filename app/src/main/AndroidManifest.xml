<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      targetSdk >= 30 filters package visibility, so a launcher must declare the
      MAIN/LAUNCHER query to see the apps it is supposed to list.
    -->
    <!--
      Car control talks to OverDrive's REST API on 127.0.0.1:8080. Android requires
      INTERNET even for loopback sockets.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi signal strength for the bar's readout; the RSSI needs no location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Bluetooth adapter and profile state for the bar's readout. Normal on this
         platform; from API 31 the equivalent is BLUETOOTH_CONNECT. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
      The cluster projection's shell-side helper hands its binder to the app in a
      broadcast; this signature permission keeps anyone else from receiving it.
    -->
    <permission
        android:name="com.example.esmerui.permission.CLUSTER_DAEMON"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.example.esmerui.permission.CLUSTER_DAEMON" />

    <!-- Overlay window for the custom navigation bar. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Bring the bars up as soon as the head unit boots. Without this they only
      appear once the home screen has run, and a boot that lands on another app -
      Android Auto reconnecting, say - leaves BYD's own bars on screen instead.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Needed only to hide the head unit's own navigation bar. Not grantable from
      the UI; grant once over adb:
        adb shell pm grant com.example.esmerui android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      BYD's automotive SDK - the same 130 permissions OverDrive requests.
      Only the *_COMMON ones are "dangerous" and auto-granted; the _GET/_SET pairs
      are signature-level and stay denied unless the app is platform-signed. They
      are declared anyway because `pm grant` refuses a permission the manifest
      never asked for, so requesting them is a precondition for even trying.
    -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_GET" tools:ignore="ProtectedPermissions" />
